# Security headers for Workers static assets.
# HTTP to HTTPS is a zone setting (Always Use HTTPS), not path redirects.
# HSTS is ignored by browsers on plaintext HTTP responses.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
